    "quickBooksWebhookContract": {
      "method": "POST",
      "path": "/api/webhooks/quickbooks/[appKey]",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "appKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "appKey"
        ]
      },
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "minItems": 1,
        "maxItems": 1000,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "specversion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "datacontenttype": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "time": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "intuitentityid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "intuitaccountid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "data": {}
          },
          "required": [
            "specversion",
            "id",
            "source",
            "type",
            "time",
            "intuitentityid",
            "intuitaccountid"
          ]
        }
      },
      "headers": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "intuit-signature": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "intuit-signature"
        ]
      },
      "response": {
        "mode": "json",
