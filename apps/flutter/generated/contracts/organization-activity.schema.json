  "contracts": {
    "getOrganizationActivityBreakdownContract": {
      "method": "GET",
      "path": "/api/organizations/[id]/usage/activity/breakdown",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ]
      },
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "preset": {
            "default": "current-period",
            "type": "string",
            "enum": [
              "current-period",
              "previous-period",
              "7d",
              "30d",
              "custom"
            ]
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "timezone": {
            "default": "UTC",
            "description": "IANA timezone for calendar boundaries; defaults to UTC.",
            "type": "string",
            "minLength": 1
          },
          "workspaceId": {
            "description": "Restrict usage to one workspace owned by the organization.",
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "dimension": {
            "default": "workspace",
            "type": "string",
            "enum": [
              "workspace",
              "workflow",
              "member",
              "trigger"
            ]
          },
          "sort": {
            "default": "runs",
            "type": "string",
            "enum": [
              "runs",
              "failures",
              "duration"
            ]
          },
          "page": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        }
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "rows": {
              "maxItems": 25,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "workflowRuns": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "completed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "failed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "chatRuns": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "chatMembers": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "failureRate": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "averageDurationMs": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "workspaceId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "description": "Unique workspace identifier."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "workspaceName": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "image": {
                    "type": "string"
                  }
                },
                "required": [
                  "workflowRuns",
                  "completed",
                  "failed",
                  "chatRuns",
                  "chatMembers",
                  "failureRate",
                  "averageDurationMs",
                  "id",
                  "label",
                  "workspaceId",
                  "workspaceName"
                ],
                "additionalProperties": false
              }
            },
            "hasMore": {
              "type": "boolean"
            }
          },
          "required": [
            "rows",
            "hasMore"
          ],
          "additionalProperties": false
        }
      }
    },
