                      "type": "string"
                    }
                  }
                },
                "statistics": {
                  "type": "object",
                  "properties": {
                    "bytesScanned": {
                      "type": "number"
                    },
                    "recordsMatched": {
                      "type": "number"
                    },
                    "recordsScanned": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "bytesScanned",
                    "recordsMatched",
                    "recordsScanned"
