              "type": "string",
              "minLength": 1
            }
          },
          "queryString": {
            "type": "string",
            "minLength": 1
          },
          "startTime": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "endTime": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "limit": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "logGroupNames",
          "queryString",
          "startTime",
          "endTime",
          "limit"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
