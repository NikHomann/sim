{
  "source": "apps/sim/lib/api/contracts/tools/aws/sqs-receive-message.ts",
  "contracts": {
    "awsSqsReceiveMessageContract": {
      "method": "POST",
      "path": "/api/tools/sqs/receive-message",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
