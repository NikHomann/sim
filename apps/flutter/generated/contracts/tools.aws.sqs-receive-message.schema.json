          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "queueUrl": {
            "type": "string",
            "minLength": 1
          },
          "maxNumberOfMessages": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              {
                "type": "null"
              }
            ]
          },
          "visibilityTimeout": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 43200
              },
              {
                "type": "null"
              }
            ]
          },
          "waitTimeSeconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              },
              {
                "type": "null"
              }
            ]
          },
          "messageAttributeNames": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "messageSystemAttributeNames": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "All",
                    "ApproximateFirstReceiveTimestamp",
                    "ApproximateReceiveCount",
                    "AWSTraceHeader",
                    "DeadLetterQueueSourceArn",
                    "MessageDeduplicationId",
                    "MessageGroupId",
                    "SenderId",
                    "SentTimestamp",
                    "SequenceNumber"
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "receiveRequestAttemptId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "queueUrl"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "messages": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "messageId": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "receiptHandle": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "body": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "md5OfBody": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "md5OfMessageAttributes": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "attributes": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "messageAttributes": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "dataType": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "stringValue": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "stringListValues": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "dataType",
                        "stringValue",
                        "stringListValues"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "messageId",
                  "receiptHandle",
                  "body",
                  "md5OfBody",
                  "md5OfMessageAttributes",
                  "attributes",
                  "messageAttributes"
                ],
                "additionalProperties": false
              }
            },
            "count": {
              "type": "number"
