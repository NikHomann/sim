                "canRead": {
                  "type": "boolean"
                },
                "canWrite": {
                  "type": "boolean"
                }
              },
              "required": [
                "canRead",
                "canWrite"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "file",
            "capabilities"
          ],
