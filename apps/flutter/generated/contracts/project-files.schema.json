                      "required": [
                        "id",
                        "token",
                        "url",
                        "isActive",
                        "resourceType",
                        "resourceId",
                        "authType",
                        "hasPassword",
                        "allowedEmails"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "owner": {
                  "type": "object",
                  "properties": {
                    "entityType": {
                      "type": "string",
                      "const": "project"
                    },
                    "entityId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "entityType",
                    "entityId"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "name",
                "key",
                "path",
                "size",
                "type",
                "uploadedBy",
                "folderId",
                "uploadedAt",
                "updatedAt",
                "owner"
              ],
              "additionalProperties": false
            },
            "capabilities": {
              "type": "object",
