            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "contentType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "folderId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "content": {
            "default": "",
            "type": "string",
            "maxLength": 70000000
          },
          "encoding": {
            "default": "utf-8",
            "type": "string",
            "enum": [
              "utf-8",
              "base64"
            ]
          },
          "exactName": {
            "default": false,
            "type": "boolean"
          },
          "folderPath": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "response": {
        "mode": "json",
        "status": 201,
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "file": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "size": {
                  "type": "number"
                },
                "type": {
                  "type": "string"
                },
                "width": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
