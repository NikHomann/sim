                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "providerId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "connectorType": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "description": {
                        "type": "string",
                        "maxLength": 240
                      },
                      "accounts": {
                        "maxItems": 100,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "credentialId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "displayName": {
                              "type": "string"
                            },
                            "status": {
                              "type": "string",
                              "enum": [
                                "connected",
                                "reconnect_needed"
                              ]
                            },
                            "action": {
                              "anyOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "type": {
                                      "type": "string",
                                      "const": "link"
                                    },
                                    "provider": {
                                      "type": "string",
                                      "minLength": 1,
                                      "maxLength": 100
                                    },
                                    "connectorType": {
                                      "type": "string",
                                      "minLength": 1,
                                      "maxLength": 100
                                    },
                                    "credentialId": {
                                      "type": "string",
                                      "minLength": 1,
                                      "maxLength": 128
                                    },
                                    "connectionMode": {
                                      "type": "string",
                                      "const": "live"
                                    },
                                    "optionId": {
                                      "type": "string",
                                      "minLength": 1,
                                      "maxLength": 128
                                    }
                                  },
                                  "required": [
                                    "type",
                                    "provider",
                                    "connectorType",
                                    "connectionMode",
                                    "optionId"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "required": [
                            "credentialId",
                            "displayName",
                            "status",
                            "action"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "connectionStatus": {
                        "type": "string",
                        "enum": [
                          "connected",
                          "reconnect_needed",
                          "not_connected",
                          "unavailable"
                        ]
                      },
                      "action": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "const": "link"
                              },
                              "provider": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 100
                              },
                              "connectorType": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 100
                              },
                              "credentialId": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                              },
                              "connectionMode": {
                                "type": "string",
                                "const": "live"
                              },
                              "optionId": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                              }
                            },
                            "required": [
                              "type",
                              "provider",
                              "connectorType",
                              "connectionMode",
                              "optionId"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "name",
                      "providerId",
                      "connectorType",
                      "description",
                      "accounts",
                      "connectionStatus",
                      "action"
                    ],
                    "additionalProperties": false
                  }
                },
                "available": {
                  "maxItems": 200,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "description": {
                        "type": "string",
                        "maxLength": 240
                      },
                      "target": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "link"
                          },
                          "provider": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "connectorType": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "credentialId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "connectionMode": {
                            "type": "string",
                            "const": "live"
                          },
                          "optionId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          }
                        },
                        "required": [
                          "type",
                          "provider",
                          "connectorType",
                          "connectionMode",
                          "optionId"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "name",
                      "description",
                      "target"
                    ],
                    "additionalProperties": false
                  }
                },
                "nextCursor": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 1024
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "completedCredentialId",
                "connections",
                "available",
                "nextCursor"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "success",
            "data"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
