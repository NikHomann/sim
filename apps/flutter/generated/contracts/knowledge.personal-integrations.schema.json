{
  "source": "apps/sim/lib/api/contracts/knowledge/personal-integrations.ts",
  "contracts": {
    "connectPersonalSearchIntegrationContract": {
      "method": "POST",
      "path": "/api/knowledge/sim-search/personal-integrations",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "link"
              },
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "connectorType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "credentialId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "connectionMode": {
                "type": "string",
                "const": "live"
              },
              "optionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "type",
              "provider",
              "connectorType",
              "connectionMode",
              "optionId"
            ],
            "additionalProperties": false
          },
          "oauthCompletionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "organizationId",
          "target",
          "oauthCompletionId"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "const": true
            },
            "data": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "success",
            "data"
          ],
          "additionalProperties": false
        }
      }
    },
    "listPersonalSearchIntegrationsContract": {
      "method": "GET",
      "path": "/api/knowledge/sim-search/personal-integrations",
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "completionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "organizationId": {
            "type": "string",
            "minLength": 1
          },
          "connectorType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "organizationId"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "const": true
            },
            "data": {
              "type": "object",
              "properties": {
                "completedCredentialId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "connections": {
