{
  "source": "apps/sim/lib/api/contracts/knowledge/github-setup.ts",
  "contracts": {
    "cancelGitHubSearchSetupContract": {
      "method": "DELETE",
      "path": "/api/knowledge/github/setup",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "minLength": 1
          },
          "setupId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "organizationId",
          "setupId"
        ],
        "additionalProperties": false
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "success"
          ],
          "additionalProperties": false
        }
      }
    },
    "completeGitHubSearchSetupContract": {
      "method": "GET",
      "path": "/api/knowledge/github/setup/callback",
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "installation_id": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[1-9]\\d*$"
          },
          "setup_action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "state"
        ]
      },
      "response": {
        "mode": "redirect"
      }
    },
    "continueGitHubSearchSetupContract": {
      "method": "GET",
      "path": "/api/knowledge/github/setup/continue",
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "minLength": 1
          },
          "setupId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "oauth": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "organizationId",
          "setupId"
        ],
        "additionalProperties": false
      },
      "response": {
        "mode": "redirect"
      }
    },
    "readGitHubSearchSetupContract": {
      "method": "GET",
      "path": "/api/knowledge/github/setup",
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "minLength": 1
          },
          "setupId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "organizationId",
          "setupId"
        ],
        "additionalProperties": false
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "const": true
            },
            "data": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "pending"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "choosing"
                    },
                    "installations": {
                      "minItems": 1,
                      "maxItems": 1000,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "installationId": {
                            "type": "string",
                            "maxLength": 32,
                            "pattern": "^[1-9]\\d*$"
                          },
                          "accountId": {
                            "type": "string",
                            "maxLength": 32,
                            "pattern": "^[1-9]\\d*$"
                          },
                          "accountLogin": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "accountType": {
                            "type": "string",
                            "enum": [
                              "User",
                              "Organization"
                            ]
                          }
                        },
                        "required": [
                          "installationId",
                          "accountId",
                          "accountLogin",
                          "accountType"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "status",
                    "installations"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "completed"
                    },
                    "credential": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "displayName": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        }
                      },
                      "required": [
                        "id",
                        "displayName"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "status",
                    "credential"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "failed"
                    },
                    "error": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  },
                  "required": [
                    "status",
                    "error"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "expired"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "success",
            "data"
          ],
          "additionalProperties": false
        }
      }
    },
    "selectGitHubSearchSetupContract": {
      "method": "POST",
      "path": "/api/knowledge/github/setup/selection",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "minLength": 1
          },
          "setupId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "action": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "select"
                  },
                  "installationId": {
                    "type": "string",
                    "maxLength": 32,
                    "pattern": "^[1-9]\\d*$"
                  }
                },
                "required": [
                  "kind",
                  "installationId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "install"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "organizationId",
          "setupId",
          "action"
        ],
        "additionalProperties": false
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "const": true
            },
            "url": {
              "type": "string",
              "maxLength": 8192,
              "format": "uri"
            }
          },
          "required": [
            "success",
            "url"
          ],
          "additionalProperties": false
        }
      }
    },
    "startGitHubSearchSetupContract": {
      "method": "POST",
      "path": "/api/knowledge/github/setup",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "minLength": 1
          },
          "setupId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "intent": {
            "type": "string",
            "const": "install"
          }
        },
        "required": [
          "organizationId",
          "setupId"
        ],
        "additionalProperties": false
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "const": true
            },
            "url": {
              "type": "string",
              "maxLength": 8192,
              "format": "uri"
            }
          },
          "required": [
            "success",
            "url"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
