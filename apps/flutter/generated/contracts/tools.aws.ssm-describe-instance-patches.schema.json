{
  "source": "apps/sim/lib/api/contracts/tools/aws/ssm-describe-instance-patches.ts",
  "contracts": {
    "awsSsmDescribeInstancePatchesContract": {
      "method": "POST",
      "path": "/api/tools/ssm/describe-instance-patches",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "instanceId": {
            "type": "string",
            "pattern": "^(i-(\\w{8}|\\w{17})|mi-\\w{17})$"
          },
          "filters": {
            "anyOf": [
              {
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "Key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "Values": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "maxResults": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 10,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "nextToken": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "instanceId"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "patches": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "kbId": {
                    "type": "string"
                  },
                  "classification": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  },
                  "installedTime": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "cveIds": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "title",
                  "kbId",
                  "classification",
                  "severity",
                  "state",
                  "installedTime",
                  "cveIds"
                ],
                "additionalProperties": false
              }
            },
            "nextToken": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "count": {
              "type": "number"
            }
          },
          "required": [
            "patches",
            "nextToken",
            "count"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
