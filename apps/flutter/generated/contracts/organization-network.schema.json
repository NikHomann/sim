{
  "source": "apps/sim/lib/api/contracts/organization-network.ts",
  "contracts": {
    "getOrganizationNetworkContract": {
      "method": "GET",
      "path": "/api/organizations/[id]/network",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "direct"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "gateway"
                },
                "publicIps": {
                  "maxItems": 16,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "ipv4",
                    "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$"
                  }
                }
              },
              "required": [
                "mode",
                "publicIps"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "blocked"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "unavailable"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    }
  }
}
