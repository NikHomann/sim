          "eventDataStoreOwnerAccountId": {
            "type": "string",
            "minLength": 12,
            "maxLength": 16,
            "pattern": "^\\d+$"
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "queryId"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "const": true
            },
            "output": {
              "type": "object",
              "properties": {
                "queryId": {
                  "type": "string"
                },
                "queryStatus": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "eventDataStoreOwnerAccountId": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "queryId",
                "queryStatus",
                "eventDataStoreOwnerAccountId"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "success",
            "output"
          ],
          "additionalProperties": false
        }
      }
    }
  }
