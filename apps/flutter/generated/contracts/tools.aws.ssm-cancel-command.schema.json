{
  "source": "apps/sim/lib/api/contracts/tools/aws/ssm-cancel-command.ts",
  "contracts": {
    "awsSsmCancelCommandContract": {
      "method": "POST",
      "path": "/api/tools/ssm/cancel-command",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "commandId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "instanceIds": {
            "anyOf": [
              {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(i-(\\w{8}|\\w{17})|mi-\\w{17})$"
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "commandId"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "commandId": {
              "type": "string"
            }
          },
          "required": [
            "message",
            "commandId"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
