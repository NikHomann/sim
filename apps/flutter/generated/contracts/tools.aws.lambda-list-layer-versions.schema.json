                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "licenseInfo": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "compatibleRuntimes": {
                        "type": "array",
                        "items": {
