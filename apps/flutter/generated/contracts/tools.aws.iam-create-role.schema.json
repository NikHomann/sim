            "maxLength": 64,
            "pattern": "^[\\w+=,.@-]+$"
          },
          "assumeRolePolicyDocument": {
            "type": "string",
            "minLength": 1,
            "maxLength": 131072,
            "pattern": "^[\\u0009\\u000A\\u000D\\u0020-\\u00FF]+$"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000,
