              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?:\\u002F|\\u002F[\\u0021-\\u007E]+\\u002F)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxSessionDuration": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 3600,
                "maximum": 43200
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "roleName",
          "assumeRolePolicyDocument"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "roleName": {
              "type": "string"
            },
            "roleId": {
              "type": "string"
            },
            "arn": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "createDate": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "message",
            "roleName",
            "roleId",
            "arn",
            "path",
            "createDate"
          ],
          "additionalProperties": false
        }
      }
