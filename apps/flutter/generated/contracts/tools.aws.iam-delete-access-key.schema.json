{
  "source": "apps/sim/lib/api/contracts/tools/aws/iam-delete-access-key.ts",
  "contracts": {
    "awsIamDeleteAccessKeyContract": {
      "method": "POST",
      "path": "/api/tools/iam/delete-access-key",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "accessKeyIdToDelete": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128,
            "pattern": "^[\\w]+$"
          },
          "userName": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[\\w+=,.@-]+$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "accessKeyIdToDelete"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            }
          },
          "required": [
            "message"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
