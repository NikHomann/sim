    "createOrganizationCredentialContract": {
      "method": "POST",
      "path": "/api/organization-credentials",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "oauth",
              "service_account"
            ]
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "providerId": {
            "type": "string",
            "minLength": 1
          },
          "accountId": {
            "type": "string",
            "minLength": 1
          },
          "envKey": {
            "type": "string",
            "minLength": 1
          },
          "envOwnerUserId": {
            "type": "string",
            "minLength": 1
          },
          "serviceAccountJson": {
            "type": "string",
            "maxLength": 2097152
          },
          "apiToken": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "atlassianProduct": {
            "type": "string",
            "enum": [
              "jira",
              "confluence"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "signingSecret": {
            "type": "string",
            "minLength": 1
          },
          "botToken": {
            "type": "string",
            "minLength": 1
          },
          "clientId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "clientSecret": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "certificateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "orgId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "dataCenter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "authMethod": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "privateKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "tenancyOcid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "userOcid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "privateKeyPassphrase": {
            "type": "string",
            "maxLength": 4096
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "organizationId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "organizationId"
        ]
      },
      "response": {
        "mode": "json",
        "status": [
          200,
          201
        ],
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "credential": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
