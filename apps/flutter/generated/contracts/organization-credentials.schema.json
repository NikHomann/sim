                "workspaceId": {
                  "type": "null"
                },
                "organizationId": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "oauth",
                    "service_account"
                  ]
                },
                "displayName": {
                  "type": "string"
                },
                "description": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "unredacted": {
                  "type": "boolean"
                },
                "providerId": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "accountId": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "envKey": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "envOwnerUserId": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "instanceUrl": {
                  "type": "string",
                  "format": "uri"
                },
                "createdBy": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string"
                },
                "updatedAt": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "admin",
                    "member"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "active",
                    "pending",
                    "revoked"
                  ]
                }
              },
              "required": [
                "id",
                "workspaceId",
                "organizationId",
                "type",
                "displayName",
                "description",
                "unredacted",
                "providerId",
                "accountId",
                "envKey",
                "envOwnerUserId",
                "createdBy",
                "createdAt",
                "updatedAt"
              ],
              "additionalProperties": false
            }
