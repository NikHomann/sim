    "createOrganizationCredentialDraftContract": {
      "method": "POST",
      "path": "/api/organization-credentials/draft",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspaceId": {
            "not": {}
          },
          "providerId": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "credentialId": {
            "type": "string",
            "minLength": 1
          },
          "oauthClientConfig": {
            "type": "object",
            "properties": {
              "clientId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "description": "Client ID for the caller-managed Intuit OAuth application."
              },
              "clientSecret": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Write-only client secret for the caller-managed Intuit OAuth application.",
                "writeOnly": true
              },
              "environment": {
                "type": "string",
                "enum": [
                  "sandbox",
                  "production"
                ],
                "description": "Intuit company environment used for authorization and API requests."
              },
              "webhookVerifierToken": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Write-only verifier token for webhook signatures from the caller-managed app.",
                "writeOnly": true
              }
            },
            "required": [
              "clientId",
              "clientSecret",
              "environment",
              "webhookVerifierToken"
            ],
            "additionalProperties": false
          },
          "organizationId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "providerId",
          "displayName",
          "organizationId"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "const": true
            },
            "draftId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "success",
            "draftId"
          ],
          "additionalProperties": false
        }
      }
    },
