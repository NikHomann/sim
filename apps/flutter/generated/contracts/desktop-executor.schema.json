{
  "source": "apps/sim/lib/api/contracts/desktop-executor.ts",
  "contracts": {
    "claimDesktopToolContract": {
      "method": "POST",
      "path": "/api/desktop/tool/claim",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "toolCallId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          }
        },
        "required": [
          "deviceId",
          "toolCallId"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "toolName": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "chatId": {
              "type": "string",
              "minLength": 1
            },
            "workspaceId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "executionToken": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "toolName",
            "args",
            "chatId",
            "workspaceId",
            "executionToken"
          ],
          "additionalProperties": false
        }
      },
      "error": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    },
    "completeDesktopToolContract": {
      "method": "POST",
      "path": "/api/desktop/tool/complete",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "toolCallId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "executionToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error",
              "cancelled"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 10000
          },
          "data": {}
        },
        "required": [
          "deviceId",
          "toolCallId",
          "executionToken",
          "status"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "recorded",
                "duplicate",
                "superseded"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "completed",
                "failed",
                "cancelled"
              ]
            }
          },
          "required": [
            "outcome",
            "status"
          ],
          "additionalProperties": false
        }
      },
      "error": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    },
    "desktopInboxStreamContract": {
      "method": "GET",
      "path": "/api/desktop/inbox/stream",
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "deviceId"
        ]
      },
      "response": {
        "mode": "stream"
      }
    },
    "importDesktopEntryContract": {
      "method": "PUT",
      "path": "/api/desktop/tool/import",
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "toolCallId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "directory"
            ]
          },
          "sourceName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "relativePath": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "deviceId",
          "toolCallId",
          "kind",
          "sourceName",
          "relativePath"
        ]
      },
      "headers": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "x-sim-execution-token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "x-sim-execution-token"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        }
      },
      "error": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    },
    "listDesktopActivityContract": {
      "method": "GET",
      "path": "/api/desktop/activity",
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Unique workspace identifier."
          }
        },
        "required": [
          "workspaceId"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "chats": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "chatId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "streamId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "running",
                      "needs_input",
                      "blocked"
                    ]
                  },
                  "deviceName": {
                    "type": "string"
                  }
                },
                "required": [
                  "chatId",
                  "streamId",
                  "state",
                  "deviceName"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "chats"
          ],
          "additionalProperties": false
        }
      },
      "error": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    },
    "listDesktopInboxContract": {
      "method": "GET",
      "path": "/api/desktop/inbox",
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "deviceId"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "call"
                      },
                      "toolCallId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                      },
                      "toolName": {
                        "type": "string",
                        "minLength": 1
                      },
                      "chatId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "workspaceId": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "createdAt": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "toolCallId",
                      "toolName",
                      "chatId",
                      "workspaceId",
                      "createdAt"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "approval_needed"
                      },
                      "toolCallId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                      },
                      "toolName": {
                        "type": "string",
                        "minLength": 1
                      },
                      "chatId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "chatTitle": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "workspaceId": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "summary": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "toolCallId",
                      "toolName",
                      "chatId",
                      "chatTitle",
                      "workspaceId",
                      "summary"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "cancel"
                      },
                      "toolCallId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                      }
                    },
                    "required": [
                      "kind",
                      "toolCallId"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "items"
          ],
          "additionalProperties": false
        }
      },
      "error": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    },
    "registerDesktopDeviceContract": {
      "method": "POST",
      "path": "/api/desktop/devices",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "appVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "platform": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "executor": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "browser": {
                "type": "boolean"
              },
              "terminal": {
                "type": "boolean"
              },
              "localFiles": {
                "type": "boolean"
              }
            },
            "required": [
              "executor",
              "browser",
              "terminal",
              "localFiles"
            ]
          }
        },
        "required": [
          "deviceId",
          "name",
          "appVersion",
          "platform",
          "capabilities"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "protocolVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "leaseMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "leaseRenewMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "reconcileMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "enabled",
            "protocolVersion",
            "leaseMs",
            "leaseRenewMs",
            "reconcileMs"
          ],
          "additionalProperties": false
        }
      },
      "error": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    },
    "renewDesktopToolLeaseContract": {
      "method": "POST",
      "path": "/api/desktop/tool/lease",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "deviceId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "toolCallId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "executionToken": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "deviceId",
              "toolCallId",
              "executionToken"
            ]
          },
          {
            "type": "object",
            "properties": {
              "toolCallId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "chatView": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "toolCallId",
              "chatView"
            ]
          }
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "renewed": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "renewed"
          ],
          "additionalProperties": false
        }
      },
      "error": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
}
