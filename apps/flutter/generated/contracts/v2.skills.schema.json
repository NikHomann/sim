              "required": [
                "email",
                "revoked"
              ],
              "additionalProperties": false,
              "id": "V2SkillEditorDeleteData",
              "title": "Revoke skill editor data",
              "description": "Skill editor revocation acknowledgement."
            }
          }
        }
      }
    },
