{
  "source": "apps/sim/lib/api/contracts/desktop-auth.ts",
  "contracts": {
    "createDesktopHandoffTokenContract": {
      "method": "POST",
      "path": "/api/desktop/auth/handoff",
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "token": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "token"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
