{
  "source": "apps/sim/lib/api/contracts/desktop-tool-authorization.ts",
  "contracts": {
    "authorizeDesktopToolContract": {
      "method": "POST",
      "path": "/api/desktop/tool/authorize",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "claim": {
            "type": "boolean"
          },
          "toolCallId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          }
        },
        "required": [
          "toolCallId"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "toolName": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "chatId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "toolName",
            "args",
            "chatId"
          ],
          "additionalProperties": false
        }
      },
      "error": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
}
