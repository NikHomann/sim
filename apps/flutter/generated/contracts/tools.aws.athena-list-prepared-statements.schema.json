{
  "source": "apps/sim/lib/api/contracts/tools/aws/athena-list-prepared-statements.ts",
  "contracts": {
    "awsAthenaListPreparedStatementsContract": {
      "method": "POST",
      "path": "/api/tools/athena/list-prepared-statements",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "workGroup": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9._-]+$"
          },
          "maxResults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "nextToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "workGroup",
          "maxResults",
          "nextToken"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "const": true
            },
            "output": {
              "type": "object",
              "properties": {
                "preparedStatements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "statementName": {
                        "type": "string"
                      },
                      "lastModifiedTime": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "statementName",
                      "lastModifiedTime"
                    ],
                    "additionalProperties": false
                  }
                },
                "nextToken": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "preparedStatements",
                "nextToken"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "success",
            "output"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
