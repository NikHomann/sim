{
  "source": "apps/sim/lib/api/contracts/tools/aws/sqs-send-message-batch.ts",
  "contracts": {
    "awsSqsSendMessageBatchContract": {
      "method": "POST",
      "path": "/api/tools/sqs/send-message-batch",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "queueUrl": {
            "type": "string",
            "minLength": 1
          },
          "entries": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "data": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "delaySeconds": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 900
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "messageAttributes": {
                  "anyOf": [
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "minLength": 1
                      },
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "dataType": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^(String|Number)(\\.[\\w.-]+)?$"
                          },
                          "stringValue": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "dataType",
                          "stringValue"
                        ]
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "messageGroupId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "messageDeduplicationId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "data"
              ]
            }
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "queueUrl",
          "entries"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "successful": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "messageId": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "md5OfMessageBody": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "md5OfMessageAttributes": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sequenceNumber": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "messageId",
                  "md5OfMessageBody",
                  "md5OfMessageAttributes",
                  "sequenceNumber"
                ],
                "additionalProperties": false
              }
            },
            "failed": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "senderFault": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "code": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "message": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "senderFault",
                  "code",
                  "message"
                ],
                "additionalProperties": false
              }
            },
            "successCount": {
              "type": "number"
            },
            "failureCount": {
              "type": "number"
            }
          },
          "required": [
            "message",
            "successful",
            "failed",
            "successCount",
            "failureCount"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
