{
  "source": "apps/sim/lib/api/contracts/tools/aws/identity-center-describe-account.ts",
  "contracts": {
    "awsIdentityCenterDescribeAccountContract": {
      "method": "POST",
      "path": "/api/tools/identity-center/describe-account",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "accountId": {
            "type": "string",
            "pattern": "^\\d{12}$"
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "accountId"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "arn": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "joinedTimestamp": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "arn",
            "name",
            "email",
            "status",
            "joinedTimestamp"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
