{
  "source": "apps/sim/lib/api/contracts/tools/aws/ssm-list-compliance-summaries.ts",
  "contracts": {
    "awsSsmListComplianceSummariesContract": {
      "method": "POST",
      "path": "/api/tools/ssm/list-compliance-summaries",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "filters": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "Key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "Values": {
                      "minItems": 1,
                      "maxItems": 20,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "Type": {
                      "type": "string",
                      "enum": [
                        "EQUAL",
                        "NOT_EQUAL",
                        "BEGIN_WITH",
                        "LESS_THAN",
                        "GREATER_THAN"
                      ]
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "maxResults": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 50
              },
              {
                "type": "null"
              }
            ]
          },
          "nextToken": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "complianceSummaryItems": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "complianceType": {
                    "type": "string"
                  },
                  "compliantCount": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "compliantSeveritySummary": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "criticalCount": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "highCount": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "mediumCount": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "lowCount": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "informationalCount": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "unspecifiedCount": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "criticalCount",
                          "highCount",
                          "mediumCount",
                          "lowCount",
                          "informationalCount",
                          "unspecifiedCount"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "nonCompliantCount": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "nonCompliantSeveritySummary": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "criticalCount": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "highCount": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "mediumCount": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "lowCount": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "informationalCount": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "unspecifiedCount": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "criticalCount",
                          "highCount",
                          "mediumCount",
                          "lowCount",
                          "informationalCount",
                          "unspecifiedCount"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "complianceType",
                  "compliantCount",
                  "compliantSeveritySummary",
                  "nonCompliantCount",
                  "nonCompliantSeveritySummary"
                ],
                "additionalProperties": false
              }
            },
            "nextToken": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "count": {
              "type": "number"
            }
          },
          "required": [
            "complianceSummaryItems",
            "nextToken",
            "count"
          ],
          "additionalProperties": false
        }
      }
    }
  }
