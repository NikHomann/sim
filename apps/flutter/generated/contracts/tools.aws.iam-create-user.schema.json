            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "userName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[\\w+=,.@-]+$"
          },
          "path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?:\\u002F|\\u002F[\\u0021-\\u007E]+\\u002F)$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "userName"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "userName": {
              "type": "string"
            },
            "userId": {
              "type": "string"
            },
            "arn": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "createDate": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "message",
            "userName",
            "userId",
            "arn",
            "path",
            "createDate"
          ],
          "additionalProperties": false
        }
      }
    }
  }
