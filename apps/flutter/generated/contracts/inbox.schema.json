{
  "source": "apps/sim/lib/api/contracts/inbox.ts",
  "contracts": {
    "addInboxSenderContract": {
      "method": "POST",
      "path": "/api/workspaces/[id]/inbox/senders",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ]
      },
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "label": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "email"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "sender": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "label": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "createdAt": {
                  "type": "string"
                },
                "workspaceId": {
                  "type": "string"
                },
                "addedBy": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "email",
                "label",
                "createdAt"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "sender"
          ],
          "additionalProperties": false
        }
      }
    },
    "getInboxConfigContract": {
      "method": "GET",
      "path": "/api/workspaces/[id]/inbox",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "address": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "secretScope": {
              "type": "string",
              "enum": [
                "all",
                "selected"
              ]
            },
            "mountedSecrets": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "entitled": {
              "type": "boolean"
            },
            "taskStats": {
              "type": "object",
              "properties": {
                "total": {
                  "type": "number"
                },
                "completed": {
                  "type": "number"
                },
                "processing": {
                  "type": "number"
                },
                "failed": {
                  "type": "number"
                }
              },
              "required": [
                "total",
                "completed",
                "processing",
                "failed"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "enabled",
            "address",
            "secretScope",
            "mountedSecrets",
            "entitled",
            "taskStats"
          ],
          "additionalProperties": false
        }
      }
    },
