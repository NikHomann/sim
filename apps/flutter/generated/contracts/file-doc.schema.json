{
  "source": "apps/sim/lib/api/contracts/file-doc.ts",
  "contracts": {
    "buildFileDocSeedContract": {
      "method": "POST",
      "path": "/api/internal/file-doc/seed",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1
          },
          "fileId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "workspaceId",
          "fileId"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "update": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "version": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "update",
            "version"
          ],
          "additionalProperties": false
        }
      }
    },
    "mergeFileDocContract": {
      "method": "POST",
      "path": "/api/internal/file-doc/merge",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string",
            "minLength": 1
          },
          "docState": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16777216
          },
          "markdown": {
            "type": "string",
            "maxLength": 8388608
          }
        },
        "required": [
          "fileId",
          "docState",
          "markdown"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "update": {
              "type": "string"
            }
          },
          "required": [
            "update"
          ],
          "additionalProperties": false
        }
      }
    },
    "persistFileDocContract": {
      "method": "POST",
      "path": "/api/internal/file-doc/persist",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1
          },
          "fileId": {
            "type": "string",
            "minLength": 1
          },
          "userId": {
            "type": "string",
            "minLength": 1
          },
          "docState": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16777216
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "workspaceId",
          "fileId",
          "userId",
          "docState"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "persisted"
                },
                "version": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "status",
                "version"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "missing"
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "deferred"
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "conflict"
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    }
  }
}
