          },
          "maxResults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "nextToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65535
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "identityStoreId",
          "groupId"
        ]
      },
      "response": {
