          "type": "object",
          "properties": {
            "memberships": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "membershipId": {
                    "type": "string"
                  },
                  "groupId": {
                    "type": "string"
                  },
                  "userId": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "membershipId",
                  "groupId",
                  "userId"
                ],
                "additionalProperties": false
              }
            },
            "nextToken": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "count": {
              "type": "number"
            }
          },
          "required": [
