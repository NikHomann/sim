{
  "source": "apps/sim/lib/api/contracts/changelog.ts",
  "contracts": {
    "listChangelogReleasesContract": {
      "method": "GET",
      "path": "/api/workspaces/[id]/changelog",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Unique workspace identifier."
          }
        },
        "required": [
          "id"
        ]
      },
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "releases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "bumpReason": {
                    "type": "string"
                  },
                  "publishedAt": {
                    "type": "string"
                  },
                  "updatedAt": {
                    "type": "string"
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  },
                  "fileId": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "changes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "text": {
                          "type": "string"
                        },
                        "workflowId": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "workflowName": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "deploymentVersionId": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "deploymentVersion": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "chatId": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "text",
                        "workflowId",
                        "workflowName",
                        "deploymentVersionId",
                        "deploymentVersion",
                        "chatId"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "workflows": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "deploymentVersion": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "deploymentVersion"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "id",
                  "version",
                  "title",
                  "bumpReason",
                  "publishedAt",
                  "updatedAt",
                  "revision",
                  "fileId",
                  "path",
                  "changes",
                  "workflows"
                ],
                "additionalProperties": false
              }
            },
            "nextCursor": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "releases",
            "nextCursor"
          ],
          "additionalProperties": false
        }
      }
    },
    "updateChangelogReleaseContract": {
      "method": "PATCH",
      "path": "/api/workspaces/[id]/changelog/[releaseId]",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Unique workspace identifier."
          },
          "releaseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "id",
          "releaseId"
        ]
      },
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "expectedRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "bumpReason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Why this release is a major, minor, or patch release, in one line."
          },
          "version": {
            "type": "string",
            "minLength": 5,
            "maxLength": 40,
            "description": "A new version label, MAJOR.MINOR.PATCH, like 1.4.0. Must not be in use."
          }
        },
        "required": [
          "expectedRevision"
        ],
        "additionalProperties": false
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "release": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "bumpReason": {
                  "type": "string"
                },
                "publishedAt": {
                  "type": "string"
                },
                "updatedAt": {
                  "type": "string"
                },
                "revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "fileId": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "changes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      },
                      "workflowId": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "workflowName": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "deploymentVersionId": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "deploymentVersion": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "chatId": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "text",
                      "workflowId",
                      "workflowName",
                      "deploymentVersionId",
                      "deploymentVersion",
                      "chatId"
                    ],
                    "additionalProperties": false
                  }
                },
                "workflows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "deploymentVersion": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "name",
                      "deploymentVersion"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "version",
                "title",
                "bumpReason",
                "publishedAt",
                "updatedAt",
                "revision",
                "fileId",
                "path",
                "changes",
                "workflows"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "release"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
