                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "maxResults": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              {
                "type": "null"
              }
            ]
          },
          "nextToken": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "path"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
