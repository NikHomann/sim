                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "lastModifiedDate": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "arn": {
                    "type": "string"
                  },
                  "dataType": {
                    "anyOf": [
                      {
                        "type": "string"
