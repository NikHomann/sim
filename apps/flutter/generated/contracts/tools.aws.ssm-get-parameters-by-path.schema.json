                    "Key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "Option": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 10
                    },
                    "Values": {
                      "minItems": 1,
                      "maxItems": 50,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
