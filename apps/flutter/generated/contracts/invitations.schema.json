              },
              "required": [
                "id",
                "kind",
                "email",
                "organizationId",
                "organizationName",
                "membershipIntent",
                "role",
                "status",
                "expiresAt",
                "createdAt",
                "inviterName",
                "inviterEmail",
                "grants"
              ],
              "additionalProperties": false
            },
            "joinPreview": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "outcome": {
                      "type": "string",
                      "enum": [
                        "will-join",
                        "already-member",
                        "external",
                        "blocked"
                      ]
                    },
                    "organizationName": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "workspacesToMove": {
                      "maxItems": 500,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "workspaceIdsToMove": {
                      "maxItems": 500,
                      "type": "array",
