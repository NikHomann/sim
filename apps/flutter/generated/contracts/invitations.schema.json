        }
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean"
            },
            "invitationCancelled": {
              "type": "boolean"
            }
          },
          "required": [
            "success",
            "invitationCancelled"
          ],
          "additionalProperties": {}
        }
      }
    },
