                },
                "grants": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "workspaceId": {
                        "type": "string"
                      },
                      "workspaceName": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "workspaceLogoUrl": {
                        "anyOf": [
                          {
                            "type": "string"
