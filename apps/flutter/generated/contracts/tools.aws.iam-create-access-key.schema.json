{
  "source": "apps/sim/lib/api/contracts/tools/aws/iam-create-access-key.ts",
  "contracts": {
    "awsIamCreateAccessKeyContract": {
      "method": "POST",
      "path": "/api/tools/iam/create-access-key",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "userName": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[\\w+=,.@-]+$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "accessKeyId": {
              "type": "string"
            },
            "secretAccessKey": {
              "type": "string"
            },
            "userName": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "createDate": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "message",
            "accessKeyId",
            "secretAccessKey",
            "userName",
            "status",
            "createDate"
          ],
          "additionalProperties": false
        }
      }
    }
  }
