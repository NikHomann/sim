{
  "source": "apps/sim/lib/api/contracts/tools/aws/sqs-start-message-move-task.ts",
  "contracts": {
    "awsSqsStartMessageMoveTaskContract": {
      "method": "POST",
      "path": "/api/tools/sqs/start-message-move-task",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "sourceArn": {
            "type": "string",
            "pattern": "^arn:[a-z0-9-]+:sqs:[a-z0-9-]+:\\d{12}:[A-Za-z0-9_-]+(\\.fifo)?$"
          },
          "destinationArn": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^arn:[a-z0-9-]+:sqs:[a-z0-9-]+:\\d{12}:[A-Za-z0-9_-]+(\\.fifo)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxNumberOfMessagesPerSecond": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "sourceArn"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "taskHandle": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "message",
            "taskHandle"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
