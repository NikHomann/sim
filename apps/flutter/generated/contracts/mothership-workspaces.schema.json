{
  "source": "apps/sim/lib/api/contracts/mothership-workspaces.ts",
  "contracts": {
    "readWorkspaceContextContract": {
      "method": "POST",
      "path": "/api/mothership/workspaces/context",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspaceId": {
            "description": "Exact workspace ID to revalidate, when known.",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "workspaceId"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "const": true
            },
            "workspaces": {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "name": {
                        "type": "string"
                      },
                      "role": {
                        "type": "string",
                        "enum": [
                          "read",
                          "write",
                          "admin"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "name",
                      "role"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "capabilityDetail": {
                            "type": "string",
                            "const": "full"
                          },
                          "capabilities": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
                              "type": "boolean"
                            }
                          }
                        },
                        "required": [
                          "capabilityDetail",
                          "capabilities"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "capabilityDetail": {
                            "type": "string",
                            "const": "restrictions"
                          },
                          "copilotAllowed": {
                            "type": "boolean"
                          },
                          "deniedCapabilities": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Static capabilities explicitly withheld by current workspace policy. Absence does not grant an operation; use exact workspaceId for the full map."
                          }
                        },
                        "required": [
                          "capabilityDetail",
                          "copilotAllowed",
                          "deniedCapabilities"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                ]
              }
            },
            "nextCursor": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "storedNotes": {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "content": {
                        "type": "string"
                      },
                      "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                      },
                      "by": {
                        "type": "string",
                        "enum": [
                          "this user",
                          "another workspace member",
                          "another user"
                        ]
                      },
                      "chat": {
                        "type": "string",
                        "enum": [
                          "this chat",
                          "another chat"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "content",
                      "updatedAt"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "user_pref",
                              "workspace_fact"
                            ]
                          }
                        },
                        "required": [
                          "kind"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "scope": {
                            "type": "string",
                            "enum": [
                              "personal",
                              "project",
                              "workspace"
                            ]
                          },
                          "visibility": {
                            "type": "string",
                            "enum": [
                              "private",
                              "shared"
                            ]
                          },
                          "projectId": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "uuid",
                                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "workspaceId": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "uuid",
                                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "revision": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "scope",
                          "visibility",
                          "projectId",
                          "workspaceId",
                          "revision"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                ]
              }
            }
          },
          "required": [
            "success",
            "workspaces",
            "nextCursor"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
