          "maxQueryResults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "nextToken": {
            "type": "string",
            "minLength": 4,
            "maxLength": 1000
          },
          "eventDataStoreOwnerAccountId": {
            "type": "string",
            "minLength": 12,
            "maxLength": 16,
            "pattern": "^\\d+$"
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "queryId",
          "maxQueryResults"
        ]
      },
      "response": {
