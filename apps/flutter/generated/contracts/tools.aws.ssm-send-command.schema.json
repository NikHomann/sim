                "type": "null"
              }
            ]
          },
          "maxConcurrency": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 7,
                "pattern": "^([1-9][0-9]*|[1-9][0-9]%|[1-9]%|100%)$"
              },
              {
                "type": "null"
