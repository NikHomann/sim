    "readProjectFileVersionContentContract": {
      "method": "GET",
      "path": "/api/projects/[id]/files/[fileId]/versions/[version]/content",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
