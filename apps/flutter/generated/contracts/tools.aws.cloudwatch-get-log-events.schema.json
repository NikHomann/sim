{
  "source": "apps/sim/lib/api/contracts/tools/aws/cloudwatch-get-log-events.ts",
  "contracts": {
    "awsCloudwatchGetLogEventsContract": {
      "method": "POST",
      "path": "/api/tools/cloudwatch/get-log-events",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "logGroupName": {
            "type": "string",
            "minLength": 1
          },
          "logStreamName": {
            "type": "string",
            "minLength": 1
          },
          "startTime": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "endTime": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "limit": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 10000
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "logGroupName",
          "logStreamName",
          "limit"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "const": true
            },
            "output": {
              "type": "object",
              "properties": {
                "events": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "timestamp": {
                        "type": "number"
                      },
                      "message": {
                        "type": "string"
                      },
                      "ingestionTime": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "events"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "success",
            "output"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
