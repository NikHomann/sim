{
  "source": "apps/sim/lib/api/contracts/tools/aws/iam-list-attached-user-policies.ts",
  "contracts": {
    "awsIamListAttachedUserPoliciesContract": {
      "method": "POST",
      "path": "/api/tools/iam/list-attached-user-policies",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "userName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[\\w+=,.@-]+$"
          },
          "pathPrefix": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?:\\u002F[A-Za-z0-9.,+@=_-]+)*\\u002F$"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxItems": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "marker": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^[\\u0020-\\u00FF]+$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "userName"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "attachedPolicies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "policyName": {
                    "type": "string"
                  },
                  "policyArn": {
                    "type": "string"
                  }
                },
                "required": [
                  "policyName",
                  "policyArn"
                ],
                "additionalProperties": false
              }
            },
            "isTruncated": {
              "type": "boolean"
            },
            "marker": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "count": {
              "type": "number"
            }
          },
          "required": [
            "attachedPolicies",
            "isTruncated",
            "marker",
            "count"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
