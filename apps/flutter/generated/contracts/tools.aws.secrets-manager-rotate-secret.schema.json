{
  "source": "apps/sim/lib/api/contracts/tools/aws/secrets-manager-rotate-secret.ts",
  "contracts": {
    "awsSecretsManagerRotateSecretContract": {
      "method": "POST",
      "path": "/api/tools/secrets_manager/rotate-secret",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "secretId": {
            "type": "string",
            "minLength": 1
          },
          "clientRequestToken": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 32,
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "rotationLambdaARN": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "automaticallyAfterDays": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 1,
                "maximum": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "duration": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 2,
                "maxLength": 3,
                "pattern": "^[0-9]+h$"
              },
              {
                "type": "null"
              }
            ]
          },
          "scheduleExpression": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[0-9A-Za-z()#?*\\-/, ]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "rotateImmediately": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "secretId"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "arn": {
              "type": "string"
            },
            "versionId": {
              "type": "string"
            }
          },
          "required": [
            "message",
            "name",
            "arn",
            "versionId"
          ],
          "additionalProperties": false
        }
      }
    }
  }
