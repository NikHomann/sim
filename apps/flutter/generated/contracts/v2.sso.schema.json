          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "providerId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Saved provider identifier."
                },
                "providerType": {
                  "type": "string",
                  "enum": [
                    "oidc",
                    "saml"
                  ],
                  "description": "Saved identity provider protocol."
