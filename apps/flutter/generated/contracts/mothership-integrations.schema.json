{
  "source": "apps/sim/lib/api/contracts/mothership-integrations.ts",
  "contracts": {
    "readIntegrationCatalogContract": {
      "method": "POST",
      "path": "/api/mothership/integrations/catalog",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "mcpServerIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mcpToolIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requiredToolIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mcpExecution": {
            "type": "object",
            "properties": {
              "workflowId": {
                "type": "string",
                "minLength": 1
              },
              "executionId": {
                "type": "string",
                "minLength": 1
              },
              "mcpBlockId": {
                "type": "string",
                "minLength": 1
              },
              "subjectUserId": {
                "type": "string",
                "minLength": 1
              },
              "principal": {
                "$ref": "#/$defs/__schema0"
              },
              "currentWorkflow": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "workflowId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "mode": {
                        "type": "string",
                        "const": "draft"
                      }
                    },
                    "required": [
                      "workflowId",
                      "mode"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "workflowId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "mode": {
                        "type": "string",
                        "const": "deployment"
                      },
                      "deploymentVersionId": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "workflowId",
                      "mode",
                      "deploymentVersionId"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "workflowId",
              "mcpBlockId"
            ],
            "additionalProperties": false
          },
          "mode": {
            "type": "string",
            "enum": [
              "agent",
              "assistant",
              "plan"
            ]
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "query": {
            "type": "string",
            "maxLength": 2000
          },
          "service": {
            "type": "string",
            "maxLength": 200
          },
          "toolId": {
            "type": "string",
            "maxLength": 500
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "mode"
        ],
        "$defs": {
          "__schema0": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              }
            ]
          }
        }
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "truncated": {
              "type": "boolean"
            },
            "operations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "toolId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "service": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "inputSchema": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "toolId",
                  "description"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "total",
            "truncated",
            "operations"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
