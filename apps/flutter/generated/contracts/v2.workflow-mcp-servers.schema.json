          },
          "required": [
            "data",
            "nextCursor",
            "truncated"
          ],
          "additionalProperties": false,
          "$defs": {
            "WorkflowMcpToolListItem": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique tool identifier."
                },
                "serverId": {
                  "type": "string",
                  "description": "Server exposing this MCP tool."
                },
                "workflowId": {
                  "type": "string",
                  "description": "Workflow this tool executes."
                },
                "toolName": {
                  "type": "string",
                  "description": "Name an MCP client calls. Derived from the supplied name or the workflow name, normalized to the MCP tool-name grammar."
                },
                "toolDescription": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Description shown to MCP clients."
                },
                "mcpServerUrl": {
                  "type": "string",
                  "description": "Endpoint an MCP client connects to."
                },
                "apiEndpoint": {
                  "type": "string",
                  "description": "Sim execution endpoint this tool calls through."
                },
                "createdAt": {
                  "type": "string",
                  "description": "ISO 8601 timestamp when the tool was created.",
                  "format": "date-time"
                },
                "updatedAt": {
                  "type": "string",
                  "description": "ISO 8601 timestamp when the tool was last modified.",
                  "format": "date-time"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "active",
                    "inactive"
                  ],
                  "description": "Whether MCP clients can call the tool. Undeploying its workflow archives the registration as `inactive`; it cannot be called and its name stays reserved. Redeploying the workflow makes it `active` again. Undeploying an inactive MCP tool permanently removes its registration."
                }
              },
              "required": [
                "id",
                "serverId",
                "workflowId",
                "toolName",
                "toolDescription",
                "mcpServerUrl",
                "apiEndpoint",
                "createdAt",
                "updatedAt",
                "status"
              ],
              "additionalProperties": false,
              "id": "WorkflowMcpToolListItem",
              "title": "Workflow MCP tool list item",
              "description": "A tool registration on a workflow MCP server. Archived registrations are included with `status: \"inactive\"`."
            }
          }
        }
      }
    },
    "v2UndeployWorkflowMcpToolContract": {
      "method": "DELETE",
      "path": "/api/v2/workflow-mcp-servers/[serverId]/tools/[workflowId]",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "serverId": {
            "type": "string",
            "minLength": 1,
            "description": "Unique workflow-MCP server identifier."
          },
          "workflowId": {
            "type": "string",
            "minLength": 1,
            "description": "Workflow registered as an MCP tool on this server."
          }
        },
        "required": [
          "serverId",
          "workflowId"
        ],
        "id": "WorkflowMcpToolParams",
        "title": "Workflow MCP tool path parameters",
        "description": "Server and workflow selected by the request path. A workflow appears at most once per server, so the pair identifies the tool."
      },
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "data": {
              "description": "Response data.",
              "$ref": "#/$defs/UndeployWorkflowMcpToolResult"
            }
          },
          "required": [
            "data"
          ],
          "additionalProperties": false,
          "$defs": {
            "UndeployWorkflowMcpToolResult": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Identifier of the removed tool."
                },
                "serverId": {
                  "type": "string",
                  "description": "Server the tool was removed from."
