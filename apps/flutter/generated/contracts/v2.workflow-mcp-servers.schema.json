    "v2ListWorkflowMcpServersContract": {
      "method": "GET",
      "path": "/api/v2/workflow-mcp-servers",
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Workspace whose workflow MCP servers to list."
          },
          "sortBy": {
            "default": "createdAt",
            "description": "Field used to sort the result. Do not rely on case-insensitive ordering when sorting by `name`.",
            "type": "string",
            "enum": [
              "name",
              "createdAt",
              "updatedAt"
            ]
          },
          "sortOrder": {
            "default": "desc",
            "description": "Sort direction.",
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "limit": {
            "default": 50,
            "description": "Maximum workflow-MCP servers to return per page. Must be a whole number from 1 to 100. Defaults to 50.",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "description": "Opaque cursor from the previous page. Send it back with the same sort and filters; only `limit` may change. Change anything else and pagination must restart without a cursor.",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "workspaceId"
        ],
        "additionalProperties": false,
        "id": "ListWorkflowMcpServersQuery",
        "title": "List workflow MCP servers query",
        "description": "Workspace scope, ordering, and pagination for workflow MCP servers."
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/WorkflowMcpServerListItem"
              },
              "description": "Items in the current page."
            },
            "nextCursor": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque cursor for the next page. Send it back as `cursor`; `null` means there are no more pages. Do not construct a cursor yourself."
            },
            "toolNamesTruncated": {
              "type": "boolean",
              "description": "Whether the page-wide tool-name limit left some inventories incomplete. Use List workflow MCP tools for one server and check its `truncated` flag before treating the inventory as complete. `nextCursor` paginates servers, not tool names."
            }
          },
          "required": [
            "data",
            "nextCursor",
            "toolNamesTruncated"
          ],
          "additionalProperties": false,
          "$defs": {
            "WorkflowMcpServerListItem": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique workflow-MCP server identifier."
                },
                "name": {
                  "type": "string",
                  "description": "Server display name, shown to connecting MCP clients."
                },
                "description": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Optional server description, or null when unset."
                },
                "isPublic": {
                  "type": "boolean",
                  "description": "Whether the server answers MCP clients without a Sim API key."
                },
                "mcpServerUrl": {
                  "type": "string",
                  "description": "MCP client endpoint. Use this returned URL instead of constructing one.",
                  "examples": [
                    "https://www.sim.ai/api/mcp/serve/wfmcp_01J8ZK3QW4M6X2R9T7B5C0V2"
                  ]
                },
                "createdAt": {
                  "type": "string",
                  "description": "ISO 8601 timestamp when the server was created.",
                  "format": "date-time"
                },
                "updatedAt": {
                  "type": "string",
                  "description": "ISO 8601 timestamp when the server was last modified.",
                  "format": "date-time"
                },
                "toolCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Number of returned tool names for this server. It may undercount registrations when the page’s `toolNamesTruncated` flag is true."
                },
                "toolNames": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Returned registered tool names, ordered alphabetically. The list may be incomplete when toolNamesTruncated is true."
                }
              },
              "required": [
                "id",
                "name",
                "description",
                "isPublic",
                "mcpServerUrl",
                "createdAt",
                "updatedAt",
                "toolCount",
                "toolNames"
              ],
              "additionalProperties": false,
              "id": "WorkflowMcpServerListItem",
              "title": "Workflow MCP server list item",
              "description": "A workflow MCP server and its bounded tool-name inventory."
            }
          }
        }
      }
    },
    "v2ListWorkflowMcpToolsContract": {
      "method": "GET",
      "path": "/api/v2/workflow-mcp-servers/[serverId]/tools",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "serverId": {
            "type": "string",
            "minLength": 1,
            "description": "Unique workflow-MCP server identifier."
          }
        },
        "required": [
          "serverId"
        ],
        "id": "WorkflowMcpServerParams",
        "title": "Workflow MCP server path parameters",
        "description": "Workflow-MCP server selected by the request path."
      },
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/WorkflowMcpToolListItem"
              },
              "description": "Items in the current page."
            },
            "nextCursor": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Always `null`. This list has no `cursor` or `limit` parameters; see the operation for inventory limits."
            },
            "truncated": {
              "type": "boolean",
