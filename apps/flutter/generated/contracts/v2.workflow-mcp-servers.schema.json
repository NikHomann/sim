{
  "source": "apps/sim/lib/api/contracts/v2/workflow-mcp-servers.ts",
  "contracts": {
    "v2CreateWorkflowMcpServerContract": {
      "method": "POST",
      "path": "/api/v2/workflow-mcp-servers",
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Workspace in which to create the workflow MCP server."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Server display name, shown to connecting MCP clients."
          },
          "description": {
            "description": "Optional server description.",
            "type": "string",
            "maxLength": 2000
          },
          "isPublic": {
            "description": "Whether the server accepts MCP clients without a Sim API key. Defaults to false; a public server lets anyone holding its URL execute the workflows it exposes.",
            "default": false,
            "type": "boolean"
          },
          "workflowIds": {
            "description": "Deployed workflows to expose as MCP tools on the new server.",
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "workspaceId",
          "name"
        ],
        "additionalProperties": false,
        "id": "CreateWorkflowMcpServerRequest",
        "title": "Create workflow MCP server request",
        "description": "A new workflow MCP server and deployed workflows to expose as tools.",
        "examples": [
          {
            "workspaceId": "9f4c2a10-3b7e-4d58-8f6a-2c1d0e5b7a94",
            "name": "Support agents",
            "workflowIds": [
              "3b1f7c92-8d4e-4a6b-9c0d-5e2f8a714b36"
            ]
          }
        ]
      },
      "response": {
        "mode": "json",
        "status": 201,
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "data": {
              "description": "Response data.",
              "$ref": "#/$defs/WorkflowMcpServer"
            }
          },
          "required": [
            "data"
          ],
          "additionalProperties": false,
          "$defs": {
            "WorkflowMcpServer": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique workflow-MCP server identifier."
                },
                "name": {
                  "type": "string",
                  "description": "Server display name, shown to connecting MCP clients."
                },
                "description": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Optional server description, or null when unset."
                },
                "isPublic": {
                  "type": "boolean",
                  "description": "Whether the server answers MCP clients without a Sim API key."
                },
                "mcpServerUrl": {
                  "type": "string",
                  "description": "MCP client endpoint. Use this returned URL instead of constructing one.",
                  "examples": [
                    "https://www.sim.ai/api/mcp/serve/wfmcp_01J8ZK3QW4M6X2R9T7B5C0V2"
                  ]
                },
                "createdAt": {
                  "type": "string",
                  "description": "ISO 8601 timestamp when the server was created.",
                  "format": "date-time"
                },
                "updatedAt": {
                  "type": "string",
                  "description": "ISO 8601 timestamp when the server was last modified.",
                  "format": "date-time"
                }
              },
              "required": [
                "id",
                "name",
                "description",
                "isPublic",
                "mcpServerUrl",
                "createdAt",
                "updatedAt"
              ],
              "additionalProperties": false,
              "id": "WorkflowMcpServer",
              "title": "Workflow MCP server",
              "description": "A workflow MCP server exposing deployed workflows as tools."
            }
          }
        }
      }
    },
    "v2DeleteWorkflowMcpServerContract": {
      "method": "DELETE",
