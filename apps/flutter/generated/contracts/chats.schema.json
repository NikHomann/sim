    "authenticateDeployedChatContract": {
      "method": "POST",
      "path": "/api/chat/[identifier]",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "identifier"
        ]
      },
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 1024
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email",
                "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              {
                "type": "string",
                "const": ""
              }
            ]
          }
        }
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "customizations": {
              "type": "object",
              "properties": {
                "primaryColor": {
                  "type": "string"
                },
                "logoUrl": {
                  "type": "string"
                },
                "imageUrl": {
                  "type": "string"
                },
                "welcomeMessage": {
                  "type": "string"
                },
                "headerText": {
                  "type": "string"
                }
              },
              "additionalProperties": {}
            },
            "authType": {
              "type": "string",
              "enum": [
                "public",
                "password",
                "email",
                "sso"
              ]
            },
            "outputConfigs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "workflowId": {
                    "type": "string"
                  },
                  "blockId": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "blockId"
                ],
                "additionalProperties": false
              }
            },
            "includeThinking": {
              "type": "boolean"
            },
            "includeToolCalls": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "title",
            "description",
            "customizations",
            "authType",
            "includeThinking",
            "includeToolCalls"
          ],
          "additionalProperties": false
        }
      }
    },
