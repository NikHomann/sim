            "enum": [
              "public",
              "password",
              "email",
              "sso"
            ]
          },
          "password": {
            "type": "string",
            "maxLength": 1024
          },
          "allowedEmails": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputConfigs": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "workflowId": {
                  "type": "string",
                  "minLength": 1
                },
                "blockId": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "blockId",
                "path"
              ]
            }
          },
          "includeThinking": {
            "default": false,
            "type": "boolean"
          },
          "includeToolCalls": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "workflowId",
          "identifier",
          "title",
          "customizations"
        ]
