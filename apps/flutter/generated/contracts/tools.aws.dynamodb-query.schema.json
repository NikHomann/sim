          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "count": {
              "type": "number"
            },
            "lastEvaluatedKey": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "message",
            "items",
            "count"
          ],
          "additionalProperties": false
        }
