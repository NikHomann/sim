{
  "source": "apps/sim/lib/api/contracts/tools/aws/dynamodb-query.ts",
  "contracts": {
    "awsDynamodbQueryContract": {
      "method": "POST",
      "path": "/api/tools/dynamodb/query",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "tableName": {
            "type": "string",
            "minLength": 1
          },
          "keyConditionExpression": {
            "type": "string",
            "minLength": 1
          },
          "filterExpression": {
            "type": "string"
          },
          "expressionAttributeNames": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "expressionAttributeValues": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "indexName": {
            "type": "string"
          },
          "limit": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "exclusiveStartKey": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "scanIndexForward": {
            "type": "boolean"
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "tableName",
          "keyConditionExpression"
        ]
      },
      "response": {
