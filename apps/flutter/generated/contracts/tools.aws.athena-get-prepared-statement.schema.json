{
  "source": "apps/sim/lib/api/contracts/tools/aws/athena-get-prepared-statement.ts",
  "contracts": {
    "awsAthenaGetPreparedStatementContract": {
      "method": "POST",
      "path": "/api/tools/athena/get-prepared-statement",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "statementName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_@:]+$"
          },
          "workGroup": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9._-]+$"
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "statementName",
          "workGroup"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "const": true
            },
            "output": {
              "type": "object",
              "properties": {
                "statementName": {
                  "type": "string"
                },
                "queryStatement": {
                  "type": "string"
                },
                "workGroupName": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "description": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lastModifiedTime": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "statementName",
                "queryStatement",
                "workGroupName",
                "description",
                "lastModifiedTime"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "success",
            "output"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
