{
  "source": "apps/sim/lib/api/contracts/v1/admin/global-work.ts",
  "contracts": {
    "adminV1GetGlobalWorkContract": {
      "method": "GET",
      "path": "/api/v1/admin/dashboard/global-work",
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "userId": {
            "type": "string",
            "minLength": 1
          },
          "organizationId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "month": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "isCurrentMonth": {
                  "type": "boolean"
                },
                "attribution": {
                  "type": "string",
                  "const": "estimated"
                },
                "scope": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "global"
                        },
                        "id": {
                          "type": "null"
                        }
                      },
                      "required": [
                        "type",
                        "id"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "user"
                        },
                        "id": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "id"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "organization"
                        },
                        "id": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "id"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "formula": {
                  "type": "object",
                  "properties": {
                    "minutesPerUnit": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "globalAnnualHours": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "minutesPerUnit",
                    "globalAnnualHours"
                  ],
                  "additionalProperties": false
                },
                "units": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "humanEquivalentHours": {
                  "type": "number",
                  "minimum": 0
                },
                "annualizedPercentGlobalWork": {
                  "type": "number",
                  "minimum": 0
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "enum": [
                          "workflow",
                          "mothership"
                        ]
                      },
                      "units": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "humanEquivalentHours": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "source",
                      "units",
                      "humanEquivalentHours"
                    ],
                    "additionalProperties": false
                  }
                },
                "daily": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "date": {
                        "type": "string"
                      },
                      "units": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "workflow": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "mothership": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "date",
                      "units",
                      "workflow",
                      "mothership"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "month",
                "label",
                "isCurrentMonth",
                "attribution",
                "scope",
                "formula",
                "units",
                "humanEquivalentHours",
                "annualizedPercentGlobalWork",
                "sources",
                "daily"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "data"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
