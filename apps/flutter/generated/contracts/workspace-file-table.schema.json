{
  "source": "apps/sim/lib/api/contracts/workspace-file-table.ts",
  "contracts": {
    "getWorkspaceCsvPreviewContract": {
      "method": "GET",
      "path": "/api/workspaces/[id]/files/[fileId]/csv-preview",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Unique workspace identifier."
          },
          "fileId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "fileId"
        ]
      },
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "v": {
            "type": "number"
          }
        },
        "required": [
          "key"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "const": true
            },
            "headers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "success",
            "headers",
            "rows",
            "truncated"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
