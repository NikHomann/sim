{
  "source": "apps/sim/lib/api/contracts/recently-deleted.ts",
  "contracts": {
    "listRecentlyDeletedContract": {
      "method": "GET",
      "path": "/api/workspaces/[id]/recently-deleted",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Unique workspace identifier."
          }
        },
        "required": [
          "id"
        ]
      },
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "type": {
            "default": "all",
            "type": "string",
            "enum": [
              "all",
              "chat",
              "table",
              "file",
              "knowledge",
              "workflow",
              "folder"
            ]
          },
          "search": {
            "type": "string",
            "maxLength": 200
          },
          "sortBy": {
            "default": "deleted",
            "type": "string",
            "enum": [
              "deleted",
              "name",
              "type"
            ]
          },
          "sortOrder": {
            "default": "desc",
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "items": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "workflow",
                      "folder",
                      "table",
                      "table_folder",
                      "knowledge",
                      "knowledge_folder",
                      "file",
                      "workspace_folder",
                      "chat"
                    ]
                  },
                  "deletedAt": {
                    "type": "string"
                  },
                  "parentId": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "name",
                  "type",
                  "deletedAt",
                  "parentId"
                ],
                "additionalProperties": false
              }
            },
            "nextCursor": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "items",
            "nextCursor"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
