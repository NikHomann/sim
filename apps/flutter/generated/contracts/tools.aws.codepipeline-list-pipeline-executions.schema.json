          },
          "pipelineName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxResults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "nextToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "succeededInStage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
