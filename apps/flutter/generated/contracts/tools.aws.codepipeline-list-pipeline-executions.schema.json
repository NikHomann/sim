                        "type": "number"
                      },
                      "lastUpdateTime": {
                        "type": "number"
                      },
                      "executionMode": {
                        "type": "string"
                      },
                      "executionType": {
                        "type": "string"
                      },
                      "stopTriggerReason": {
                        "type": "string"
                      },
                      "triggerType": {
                        "type": "string"
                      },
                      "triggerDetail": {
                        "type": "string"
                      },
