{
  "source": "apps/sim/lib/api/contracts/tools/aws/sqs-send-message.ts",
  "contracts": {
    "awsSqsSendMessageContract": {
      "method": "POST",
      "path": "/api/tools/sqs/send-message",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "queueUrl": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "delaySeconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 900
              },
              {
                "type": "null"
              }
            ]
          },
          "messageAttributes": {
            "anyOf": [
              {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "dataType": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(String|Number)(\\.[\\w.-]+)?$"
                    },
                    "stringValue": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "dataType",
                    "stringValue"
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "messageGroupId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "messageDeduplicationId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "queueUrl",
          "data"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "md5OfMessageBody": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "md5OfMessageAttributes": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sequenceNumber": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "message",
            "id",
            "md5OfMessageBody",
            "md5OfMessageAttributes",
            "sequenceNumber"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
