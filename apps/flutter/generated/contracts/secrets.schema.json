{
  "source": "apps/sim/lib/api/contracts/secrets.ts",
  "contracts": {
    "getSecretReferencesContract": {
      "method": "GET",
      "path": "/api/secrets/references",
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "workspaceId",
          "name"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "workflows": {
              "maxItems": 2000,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "workflowId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "workflowName": {
                    "type": "string"
                  },
                  "blocks": {
                    "minItems": 1,
                    "maxItems": 2000,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "blockId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "blockName": {
                          "type": "string"
                        },
                        "blockType": {
                          "type": "string",
                          "minLength": 1
                        },
                        "field": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "blockId",
                        "blockName",
                        "blockType",
                        "field"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "workflowId",
                  "workflowName",
                  "blocks"
                ],
                "additionalProperties": false
              }
            },
            "resources": {
              "maxItems": 400,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "custom-tool",
                      "mcp-server"
                    ]
                  },
                  "name": {
                    "type": "string"
                  },
                  "field": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "name",
                  "field"
                ],
                "additionalProperties": false
              }
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "workflows",
            "resources",
            "truncated"
          ],
          "additionalProperties": false
        }
      }
    },
    "getSecretUsageContract": {
      "method": "GET",
      "path": "/api/secrets/usage",
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "enum": [
              "workspace",
              "personal"
            ]
          },
          "limit": {
            "default": 100,
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        },
        "required": [
          "workspaceId",
          "name",
          "scope"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "useCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "lastUsedAt": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "workflow",
                      "copilot",
                      "mcp"
                    ]
                  },
                  "workflowName": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "actorName": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "lastExecutionId": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "lastExecutionAvailable": {
                    "type": "boolean"
                  },
                  "lastTrigger": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "useCount",
                  "lastUsedAt",
                  "source",
                  "workflowName",
                  "actorName",
                  "lastExecutionId",
                  "lastExecutionAvailable",
                  "lastTrigger"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "entries"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
