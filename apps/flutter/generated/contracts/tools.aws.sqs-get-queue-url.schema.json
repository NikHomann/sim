{
  "source": "apps/sim/lib/api/contracts/tools/aws/sqs-get-queue-url.ts",
  "contracts": {
    "awsSqsGetQueueUrlContract": {
      "method": "POST",
      "path": "/api/tools/sqs/get-queue-url",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "queueName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9_-]+(\\.fifo)?$"
          },
          "queueOwnerAwsAccountId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{12}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "queueName"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "queueUrl": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "queueUrl"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
