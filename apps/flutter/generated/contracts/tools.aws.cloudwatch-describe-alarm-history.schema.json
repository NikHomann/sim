{
  "source": "apps/sim/lib/api/contracts/tools/aws/cloudwatch-describe-alarm-history.ts",
  "contracts": {
    "awsCloudwatchDescribeAlarmHistoryContract": {
      "method": "POST",
      "path": "/api/tools/cloudwatch/describe-alarm-history",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
