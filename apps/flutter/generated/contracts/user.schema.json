    "getUsageLogsContract": {
      "method": "GET",
      "path": "/api/users/me/usage-logs",
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "workflow",
              "wand",
              "sim-chat",
              "mcp_copilot",
              "mothership_block",
              "knowledge-base",
              "voice-input",
              "enrichment",
              "voice-output",
              "api-tool"
            ]
          },
          "workspaceId": {
            "type": "string"
          },
          "period": {
            "default": "30d",
            "type": "string",
            "enum": [
              "1d",
              "7d",
              "30d",
              "all",
              "custom"
            ]
          },
          "startDate": {
            "type": "string",
            "minLength": 1
          },
          "endDate": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "default": 50,
            "type": "number",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string"
          },
          "includeCredits": {
            "type": "boolean"
          }
        }
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean"
            },
            "logs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "createdAt": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "workflow",
                      "wand",
                      "sim-chat",
                      "mcp_copilot",
                      "mothership_block",
                      "knowledge-base",
                      "voice-input",
                      "enrichment",
                      "voice-output",
                      "api-tool"
                    ]
                  },
                  "workflowName": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "creditCost": {
                    "type": "number"
                  },
                  "hasCost": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "createdAt",
                  "source",
                  "workflowName",
                  "creditCost",
                  "hasCost"
                ],
                "additionalProperties": false
              }
            },
            "summary": {
              "type": "object",
              "properties": {
                "totalCredits": {
                  "type": "number"
                },
                "bySourceCredits": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "number"
                  }
                }
              },
              "required": [
                "totalCredits",
                "bySourceCredits"
              ],
              "additionalProperties": false
            },
            "pagination": {
              "type": "object",
              "properties": {
                "nextCursor": {
                  "type": "string"
                },
                "hasMore": {
                  "type": "boolean"
                }
              },
              "required": [
                "hasMore"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "success",
            "logs",
            "summary",
            "pagination"
          ],
          "additionalProperties": false
        }
      }
    },
