    "listAuthorizedAppsContract": {
      "method": "GET",
      "path": "/api/users/me/authorized-apps",
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "search": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "apps": {
              "maxItems": 25,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "clientId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "scopes": {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  },
                  "authorizedAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                  }
                },
                "required": [
                  "clientId",
                  "name",
                  "scopes",
                  "authorizedAt"
                ],
                "additionalProperties": false
              }
            },
            "nextCursor": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "apps",
            "nextCursor"
          ],
          "additionalProperties": false
        }
      }
    },
    "resetPasswordContract": {
      "method": "POST",
      "path": "/api/auth/reset-password",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 100,
            "allOf": [
              {
                "pattern": "[A-Z]"
              },
              {
                "pattern": "[a-z]"
              },
              {
                "pattern": "[0-9]"
              },
              {
                "pattern": "[^A-Za-z0-9]"
              }
            ]
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "success"
          ],
          "additionalProperties": false
        }
      }
    },
