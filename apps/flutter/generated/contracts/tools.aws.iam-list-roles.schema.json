{
  "source": "apps/sim/lib/api/contracts/tools/aws/iam-list-roles.ts",
  "contracts": {
    "awsIamListRolesContract": {
      "method": "POST",
      "path": "/api/tools/iam/list-roles",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "pathPrefix": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^\\u002F[\\u0021-\\u007F]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxItems": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "marker": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^[\\u0020-\\u00FF]+$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "roles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "roleName": {
                    "type": "string"
                  },
                  "roleId": {
                    "type": "string"
                  },
                  "arn": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "createDate": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "description": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "maxSessionDuration": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "roleName",
                  "roleId",
                  "arn",
                  "path",
                  "createDate",
                  "description",
                  "maxSessionDuration"
                ],
                "additionalProperties": false
              }
            },
            "isTruncated": {
              "type": "boolean"
            },
            "marker": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "count": {
              "type": "number"
            }
          },
          "required": [
            "roles",
            "isTruncated",
            "marker",
            "count"
          ],
          "additionalProperties": false
        }
      }
    }
  }
