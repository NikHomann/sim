    "restoreProjectFileFolderContract": {
      "method": "POST",
      "path": "/api/projects/[id]/files/folders/[folderId]/restore",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
