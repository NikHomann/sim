    "v2ListMcpServerToolsContract": {
      "method": "GET",
      "path": "/api/v2/mcp-servers/[mcpServerId]/tools",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "mcpServerId": {
            "type": "string",
            "minLength": 1,
            "description": "Unique MCP server identifier."
          }
        },
        "required": [
          "mcpServerId"
        ]
      },
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Workspace that owns the MCP server."
          },
          "refresh": {
            "description": "Refresh tools using your credentials. Otherwise results may reuse another workspace member's recent discovery and omit newly added tools.",
            "type": "boolean"
          }
        },
        "required": [
          "workspaceId"
        ],
        "additionalProperties": false
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/V2McpTool"
              },
              "description": "Items in the current page."
            },
            "nextCursor": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Always `null`. This list has no `cursor` or `limit` parameters; see the operation for inventory limits."
            }
          },
          "required": [
            "data",
            "nextCursor"
          ],
          "additionalProperties": false,
          "$defs": {
            "V2McpTool": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Tool name, as the MCP server reports it."
                },
                "description": {
                  "description": "Tool description reported by the server.",
                  "type": "string"
                },
                "inputSchema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "object",
                      "description": "JSON Schema type of the argument object. MCP requires `object`."
                    },
                    "properties": {
                      "description": "Argument schemas keyed by argument name.",
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "description": "Server-defined JSON Schema for one tool argument."
                      }
                    },
                    "required": {
                      "description": "Names of the arguments the tool requires.",
                      "type": "array",
                      "items": {
                        "type": "string",
                        "description": "Name of a required argument."
                      }
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": {
                    "description": "Additional JSON Schema keyword reported by the server."
                  },
                  "description": "JSON Schema for the tool's arguments, as reported by the server."
                },
                "serverId": {
                  "type": "string",
                  "description": "Identifier of the MCP server exposing the tool."
                },
                "serverName": {
                  "type": "string",
                  "description": "Display name of the MCP server exposing the tool."
                }
              },
              "required": [
                "name",
                "inputSchema",
                "serverId",
                "serverName"
              ],
              "additionalProperties": false,
              "id": "V2McpTool",
              "title": "MCP tool",
              "description": "A tool exposed by a registered MCP server."
            }
          }
        }
      }
    },
    "v2ListMcpServersContract": {
      "method": "GET",
      "path": "/api/v2/mcp-servers",
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Workspace that owns the MCP server."
          },
          "search": {
            "description": "Case-insensitive substring match against the server name.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sortBy": {
            "default": "createdAt",
            "description": "Field used to sort the result. Do not rely on case-insensitive ordering when sorting by `name`.",
            "type": "string",
            "enum": [
              "name",
              "createdAt",
              "updatedAt"
            ]
          },
          "sortOrder": {
            "default": "desc",
            "description": "Sort direction.",
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "limit": {
            "default": 50,
            "description": "Maximum MCP servers to return per page. Must be a whole number from 1 to 100. Defaults to 50.",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "description": "Opaque cursor from the previous page. Send it back with the same sort and filters; only `limit` may change. Change anything else and pagination must restart without a cursor.",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "workspaceId"
        ],
        "additionalProperties": false
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/V2McpServer"
              },
              "description": "Items in the current page."
