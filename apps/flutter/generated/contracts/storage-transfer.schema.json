    "fileDeleteContract": {
      "method": "POST",
      "path": "/api/files/delete",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "filePath": {
            "type": "string"
          },
          "context": {
            "type": "string",
            "enum": [
              "knowledge-base",
              "chat",
              "copilot",
              "mothership",
              "execution",
              "workspace",
              "profile-pictures",
              "og-images",
              "logs",
              "workspace-logos",
              "organization-logos"
            ]
          }
        },
        "additionalProperties": {}
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      }
    },
    "fileExportContract": {
      "method": "GET",
