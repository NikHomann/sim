{
  "source": "apps/sim/lib/api/contracts/tools/aws/athena-batch-get-prepared-statement.ts",
  "contracts": {
    "awsAthenaBatchGetPreparedStatementContract": {
      "method": "POST",
      "path": "/api/tools/athena/batch-get-prepared-statement",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "preparedStatementNames": {
            "minItems": 1,
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_@:]+$"
            }
          },
          "workGroup": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9._-]+$"
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "preparedStatementNames",
          "workGroup"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "const": true
            },
            "output": {
              "type": "object",
              "properties": {
                "preparedStatements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "statementName": {
                        "type": "string"
                      },
                      "queryStatement": {
                        "type": "string"
                      },
                      "workGroupName": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "description": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "lastModifiedTime": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "statementName",
                      "queryStatement",
                      "workGroupName",
                      "description",
                      "lastModifiedTime"
                    ],
                    "additionalProperties": false
                  }
                },
                "unprocessedPreparedStatementNames": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "statementName": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "errorCode": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "errorMessage": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "statementName",
                      "errorCode",
                      "errorMessage"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "preparedStatements",
                "unprocessedPreparedStatementNames"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "success",
            "output"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
