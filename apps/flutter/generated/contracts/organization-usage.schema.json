      },
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "timezone": {
            "default": "UTC",
            "description": "IANA timezone for calendar boundaries; defaults to UTC.",
            "type": "string",
            "minLength": 1
          },
          "workspaceId": {
            "description": "Restrict usage to one workspace owned by the organization.",
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "days": {
              "minItems": 365,
              "maxItems": 365,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  "credits": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "hasCost": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "date",
                  "credits",
                  "hasCost"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "days"
          ],
          "additionalProperties": false
        }
      }
    },
    "getOrganizationUsageOverviewContract": {
      "method": "GET",
      "path": "/api/organizations/[id]/usage/overview",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
