{
  "source": "apps/sim/lib/api/contracts/organization-usage.ts",
  "contracts": {
    "exportOrganizationUsageContract": {
      "method": "GET",
      "path": "/api/organizations/[id]/usage/export",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ]
      },
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "preset": {
            "default": "current-period",
            "type": "string",
            "enum": [
              "current-period",
              "previous-period",
              "7d",
              "30d",
              "custom"
            ]
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "timezone": {
            "default": "UTC",
            "description": "IANA timezone for calendar boundaries; defaults to UTC.",
            "type": "string",
            "minLength": 1
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      },
      "response": {
        "mode": "text"
      }
    },
    "getOrganizationUsageBreakdownContract": {
      "method": "GET",
      "path": "/api/organizations/[id]/usage/breakdown",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ]
      },
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "preset": {
            "default": "current-period",
            "type": "string",
            "enum": [
              "current-period",
              "previous-period",
              "7d",
              "30d",
              "custom"
            ]
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "timezone": {
            "default": "UTC",
            "description": "IANA timezone for calendar boundaries; defaults to UTC.",
            "type": "string",
            "minLength": 1
          },
          "workspaceId": {
            "description": "Restrict usage to one workspace owned by the organization.",
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "dimension": {
            "type": "string",
            "enum": [
              "member",
              "workspace",
              "workflow",
              "model",
              "byok",
              "source"
            ],
            "description": "Usage grouping dimension."
          },
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "dimension",
          "limit"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "dimension": {
              "type": "string",
              "enum": [
                "member",
                "workspace",
                "workflow",
                "model",
                "byok",
                "source"
              ],
              "description": "Usage grouping dimension."
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Group identifier; an empty ID represents unattributed usage."
                  },
                  "label": {
                    "type": "string",
                    "description": "Display label for the usage group."
                  },
                  "credits": {
                    "type": "number",
                    "description": "Whole credits attributed to this total or group."
                  },
                  "events": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991,
                    "description": "Number of usage events."
                  },
                  "share": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Fraction of total cost, or total tokens for BYOK, between zero and one."
                  },
                  "providerId": {
                    "description": "Model provider identifier, when applicable.",
                    "type": "string"
                  },
                  "tokens": {
                    "description": "Input and output tokens for model or BYOK groups.",
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "image": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "credits",
                  "events",
                  "share"
                ],
                "additionalProperties": false
              }
            },
            "other": {
              "type": "object",
              "properties": {
                "credits": {
                  "type": "number",
                  "description": "Whole credits attributed to this total or group."
                },
                "events": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Number of usage events."
                },
                "rowCount": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Number of groups omitted from rows."
                },
                "tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Input and output tokens attributed to omitted groups."
                }
              },
              "required": [
                "credits",
                "events",
                "rowCount",
                "tokens"
              ],
              "additionalProperties": false,
              "description": "Combined usage for groups omitted by the limit."
            },
            "totalCredits": {
              "type": "number",
              "description": "Whole credits represented by this breakdown; workflow includes only workflow-attributed usage."
            }
          },
          "required": [
            "dimension",
            "rows",
            "other",
            "totalCredits"
          ],
          "additionalProperties": false
        }
      }
    },
    "getOrganizationUsageCalendarContract": {
      "method": "GET",
      "path": "/api/organizations/[id]/usage/calendar",
