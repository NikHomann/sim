    "createKnowledgeChunkContract": {
      "method": "POST",
      "path": "/api/knowledge/[id]/documents/[documentId]/chunks",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
