                "Policy",
                "ReceiveMessageWaitTimeSeconds",
                "RedriveAllowPolicy",
                "RedrivePolicy",
                "SqsManagedSseEnabled",
                "VisibilityTimeout"
              ]
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "queueUrl",
          "attributes"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
