{
  "source": "apps/sim/lib/api/contracts/mothership-run-control.ts",
  "contracts": {
    "readRunControlContract": {
      "method": "POST",
      "path": "/api/mothership/runs/control",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "chatId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "streamId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "chatId",
          "streamId"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "stopped": {
              "type": "boolean"
            }
          },
          "required": [
            "stopped"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
