  "source": "apps/sim/lib/api/contracts/tools/aws/lambda-create-alias.ts",
  "contracts": {
    "awsLambdaCreateAliasContract": {
      "method": "POST",
      "path": "/api/tools/lambda/create-alias",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
