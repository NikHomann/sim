            "maxLength": 256
          },
          "additionalVersionWeights": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "functionName",
          "aliasName",
          "aliasFunctionVersion"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
