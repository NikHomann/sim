                      ]
                    }
                  },
                  "required": [
                    "aliasArn",
                    "name",
                    "functionVersion",
                    "description",
                    "revisionId",
                    "routingConfig"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "alias"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "success",
            "output"
          ],
          "additionalProperties": false
        }
      }
    }
  }
