{
  "source": "apps/sim/lib/api/contracts/tools/aws/identity-center-describe-group.ts",
  "contracts": {
    "awsIdentityCenterDescribeGroupContract": {
      "method": "POST",
      "path": "/api/tools/identity-center/describe-group",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "identityStoreId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "pattern": "^(d-[0-9a-f]{10}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
          },
          "groupId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 47,
            "pattern": "^([0-9a-f]{10}-)?[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$"
          }
        },
        "required": [
          "region",
          "accessKeyId",
          "secretAccessKey",
          "identityStoreId",
          "groupId"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "groupId": {
              "type": "string"
            },
            "displayName": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "externalIds": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "issuer": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "issuer",
                  "id"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "groupId",
            "displayName",
            "description",
            "externalIds"
          ],
          "additionalProperties": false
        }
      }
    }
  }
