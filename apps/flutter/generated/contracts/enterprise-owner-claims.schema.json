          "required": [
            "id",
            "ownerEmail",
            "organizationName",
            "organizationId",
            "provisioningOperationId",
            "stage",
            "status",
            "error",
            "expiresAt",
            "createdAt",
            "updatedAt",
            "invoiceAmountUsd",
            "billingInterval",
            "seats",
            "invitations",
