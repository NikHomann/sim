            "seats": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "invitations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "workspacePreview": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "workspacesToMove": {
                      "type": "array",
