{
  "source": "apps/sim/lib/api/contracts/desktop-browser-files.ts",
  "contracts": {
    "readBrowserUploadFileContract": {
      "method": "POST",
      "path": "/api/desktop/tool/file",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "toolCallId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          }
        },
        "required": [
          "toolCallId",
          "index"
        ]
      },
      "response": {
        "mode": "binary"
      }
    },
    "saveBrowserDownloadContract": {
      "method": "PUT",
      "path": "/api/desktop/tool/file",
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "toolCallId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "toolCallId",
          "name"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "path",
            "name",
            "size"
          ],
          "additionalProperties": false
        }
      },
      "error": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
}
