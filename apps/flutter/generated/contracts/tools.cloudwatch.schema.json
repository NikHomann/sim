{
  "source": "apps/sim/lib/api/contracts/tools/cloudwatch.ts",
  "contracts": {
    "cloudwatchLogGroupsContract": {
      "method": "POST",
      "path": "/api/tools/cloudwatch/describe-log-groups",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "prefix": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "accessKeyId",
          "secretAccessKey",
          "region"
        ]
      },
      "response": {
        "mode": "json",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean"
            },
            "output": {
              "type": "object",
              "properties": {
                "logGroups": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "logGroupName": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "logGroupName"
                    ],
                    "additionalProperties": {}
                  }
                }
              },
              "required": [
                "logGroups"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "output"
          ],
          "additionalProperties": {}
        }
      }
    },
    "cloudwatchLogStreamsContract": {
      "method": "POST",
      "path": "/api/tools/cloudwatch/describe-log-streams",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "accessKeyId": {
            "type": "string",
            "minLength": 1
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "prefix": {
            "type": "string"
